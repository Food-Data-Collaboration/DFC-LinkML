{
    "name": "siol-data/dfc-connector",
    "type": "library",
    "description": "DFC LinkML Semantic Object Connector for PHP",
    "keywords": [
        "data food consortium",
        "short supply chain",
        "farming",
        "semantic web",
        "rdf",
        "object model"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Food-Data-Collaboration/DFC-LinkML",
    "support": {
        "source": "https://github.com/Food-Data-Collaboration/DFC-LinkML/tree/main/php-connector",
        "issues": "https://github.com/Food-Data-Collaboration/DFC-LinkML/issues"
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "DataFoodConsortium\\Connector\\": "php-connector/src"
        }
    },
    "archive": {
        "exclude": [
            "/composer.json",
            "/LICENSE",
            "/AGENTS.md",
            "/Makefile",
            "/config",
            "/docs",
            "/scripts",
            "/shacl",
            "/src",
            "/tests",
            "/ruby-gem",
            "/typescript-connector",
            "/.github"
        ]
    }
}
