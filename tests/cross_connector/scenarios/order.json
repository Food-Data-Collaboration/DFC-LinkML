{
  "name": "order",
  "version": "2.0.0",
  "objects": [
    {
      "type": "dfc-b:Organization",
      "semanticId": "http://example.com/org1",
      "params": { "name": "Farm Org", "description": "A test farm" }
    },
    {
      "type": "dfc-b:Order",
      "semanticId": "http://example.com/order1",
      "params": {
        "orderNumber": "ORD-001",
        "orderedBy": { "$ref": "http://example.com/org1" },
        "hasPart": { "$ref": "http://example.com/line1" }
      }
    },
    {
      "type": "dfc-b:OrderLine",
      "semanticId": "http://example.com/line1",
      "params": {
        "name": "Line 1",
        "quantity": 5,
        "concerns": "http://example.com/tomato"
      }
    }
  ]
}
